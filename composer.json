{
    "name": "alfacode-team/hkm-plugin-school-attendance",
    "description": "Derives daily arrival/departure from the raw biometric scan stream; manual entry, analytics and reports.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\SchoolAttendance\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\SchoolAttendance\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
